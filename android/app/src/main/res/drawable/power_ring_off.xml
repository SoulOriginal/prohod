<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- faint outer glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="110"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- track ring + inner fill -->
    <item
        android:left="28dp"
        android:top="28dp"
        android:right="28dp"
        android:bottom="28dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90"
                android:startColor="#1A2230"
                android:endColor="#121722" />
            <stroke android:width="3dp" android:color="@color/accent_off" />
        </shape>
    </item>
</layer-list>
